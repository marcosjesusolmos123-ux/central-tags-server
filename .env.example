# Servidor
PORT=3001
# Orígenes permitidos separados por coma. Vacío conserva compatibilidad y permite cualquier origen.
CORS_ORIGINS=

# Google Cloud Vision: credenciales locales fuera del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\segura\google-service-account.json
GOOGLE_CLOUD_PROJECT=central-tags-ocr
# Render: alternativa al archivo local (no incluir credenciales reales aquí).
GOOGLE_CREDENTIALS_JSON=

# Firebase Admin (Authentication y Firestore).
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/firebase-admin.json
FIREBASE_PROJECT_ID=central-tags
# FIRESTORE_DATABASE_ID=(default)
# Render: alternativa al archivo local (no incluir credenciales reales aquí).
FIREBASE_CREDENTIALS_JSON=

# Administración de OCR
ADMIN_MAX_OCR_LIMIT=100000

# Estimación de Google Vision. Son valores globales del proyecto, no la cuota free por usuario.
VISION_COST_PER_1000_OCR=0
VISION_MONTHLY_FREE_UNITS=0
VISION_COST_CURRENCY=USD
