# Desarrollo local: ruta absoluta a un archivo de credenciales fuera del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\segura\google-service-account.json

# Opcional: ID del proyecto de Google Cloud.
GOOGLE_CLOUD_PROJECT=central-tags-ocr

# Render: en lugar de GOOGLE_APPLICATION_CREDENTIALS, pegar el JSON completo
# de la cuenta de servicio en GOOGLE_CREDENTIALS_JSON desde el panel Environment.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
