# Desarrollo local: ruta absoluta a un archivo de credenciales fuera del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\segura\google-service-account.json

# Opcional: ID del proyecto de Google Cloud.
GOOGLE_CLOUD_PROJECT=central-tags-ocr

# Render: en lugar de GOOGLE_APPLICATION_CREDENTIALS, pegar el JSON completo
# de la cuenta de servicio en GOOGLE_CREDENTIALS_JSON desde el panel Environment.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Firebase Admin (proyecto de Firebase Authentication y Firestore).
# Desarrollo local: ruta al JSON de Firebase Admin. No usar aquí la clave de Vision.
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/central-tags-firebase-adminsdk-fbsvc-c8767ff7e1.json
FIREBASE_PROJECT_ID=central-tags

# Opcional. Omitir para usar la base de datos Firestore predeterminada.
# FIRESTORE_DATABASE_ID=(default)

# Producción: alternativa a FIREBASE_SERVICE_ACCOUNT_PATH.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
